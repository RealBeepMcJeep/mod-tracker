# Fail closed: only source, tests, and documentation are tracked.
*
!.gitignore
!AGENTS.md
!README.md
!TODO.md
!CHANGELOG.md
!DATA_FLOW.html
!tracker.py
!games.json
!scripts/
!scripts/manual-pass.py
!tests/
!tests/**

# Generated datasets, source captures, reports, and secrets stay local.
data/
raw/
snapshots/
report.html
report-hotlinked.html
*cookies*
*cookie-jar*
*.env

# Never track transient writes or Python caches.
**/*.tmp
**/__pycache__/
**/*.pyc
